<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Админ-панель — Проверка номеров</title>
  <link rel="stylesheet" href="/admin.css"/>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <strong>Админ-панель • Проверка номеров</strong>
      <div class="actions">
        <a class="btn" href="/?lang=en">На сайт</a>
        <form method="POST" action="/admin/logout" style="margin:0">
          <button class="btn bad" type="submit">Выйти</button>
        </form>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h2>Создать / обновить заявку</h2>

        <% if (flash) { %>
          <div class="notice"><%= flash %></div>
          <div style="height:10px"></div>
        <% } %>

        <form method="POST" action="/admin/upsert">
          <label>Код заявки</label>
          <div class="row">
            <input name="code" value="<%= form.code || '' %>" placeholder="оставь пустым для автогенерации"/>
            <button class="btn good" type="submit" name="action" value="generate">Сгенерировать код</button>
          </div>
          <p class="small">Код можно сгенерировать автоматически. Если вводишь вручную — система примет твой код.</p>

          <hr/>

          <label>Статус (выбор на английском)</label>
          <select name="status" required>
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= (form.status===s) ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>

          <div style="height:10px"></div>

          <div class="row">
            <div>
              <label>Сообщение (RU)</label>
              <textarea name="message_ru" placeholder="Текст для клиента на русском"><%= form.message_ru || '' %></textarea>
            </div>
            <div>
              <label>Message (EN)</label>
              <textarea name="message_en" placeholder="Text for the client in English"><%= form.message_en || '' %></textarea>
            </div>
          </div>

          <div style="height:10px"></div>

          <div class="actions">
            <button class="btn good" type="submit" name="action" value="save">Сохранить</button>
            <button class="btn" type="submit" name="action" value="auto_translate">Auto-translate (RU→EN)</button>
          </div>

          <p class="small">
            ⚠️ Авто-перевод для произвольного текста работает только если задан <code>TRANSLATE_ENDPOINT</code>.
            Без него нужно заполнять RU и EN вручную.
          </p>
        </form>
      </div>

      <div class="card">
        <h2>Список заявок</h2>
        <table class="table">
          <thead>
            <tr>
              <th style="width:170px">Код</th>
              <th style="width:220px">Статус (EN)</th>
              <th>Сообщение (RU / EN)</th>
              <th style="width:170px">Обновлено</th>
              <th style="width:120px">Действия</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(r => { %>
              <tr>
                <td><code><%= r.code %></code></td>
                <td>
                  <% 
                    let cls = 'pill';
                    if (r.status === 'Approved' || r.status === 'Granted') cls += ' good';
                    else if (r.status === 'Refused' || r.status === 'Cancelled') cls += ' bad';
                    else cls += ' warn';
                  %>
                  <span class="<%= cls %>"><%= r.status %></span>
                </td>
                <td>
                  <div style="display:grid;gap:6px">
                    <div><strong>RU:</strong> <%= (r.message_ru || '—') %></div>
                    <div><strong>EN:</strong> <%= (r.message_en || '—') %></div>
                  </div>
                </td>
                <td><%= r.updated_at_display %></td>
                <td>
                  <form method="GET" action="/admin" style="margin:0;display:flex;gap:8px;flex-wrap:wrap">
                    <input type="hidden" name="edit" value="<%= r.code %>"/>
                    <button class="btn" type="submit">Редакт.</button>
                  </form>
                  <form method="POST" action="/admin/delete" style="margin-top:8px">
                    <input type="hidden" name="code" value="<%= r.code %>"/>
                    <button class="btn bad" type="submit" onclick="return confirm('Удалить запись?')">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <p class="small">Публичная проверка доступна на <code>/check</code>. Язык переключается кнопкой EN/RU.</p>
      </div>
    </div>
  </div>
</body>
</html>
