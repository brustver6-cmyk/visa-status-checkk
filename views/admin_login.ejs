<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Админ-панель — Вход</title>
  <link rel="stylesheet" href="/admin.css"/>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <strong>Админ-панель</strong>
      <a class="btn" href="/?lang=en">На сайт</a>
    </div>

    <div class="grid" style="grid-template-columns: 1fr; max-width:520px">
      <div class="card">
        <h2>Вход</h2>
        <% if (error) { %>
          <div class="notice" style="border-style:solid;border-color:rgba(209,75,75,.3);color:#ffd7d7"><%= error %></div>
          <div style="height:10px"></div>
        <% } %>
        <form method="POST" action="/admin/login">
          <label>Логин</label>
          <input name="username" autocomplete="username" required/>
          <div style="height:10px"></div>
          <label>Пароль</label>
          <input name="password" type="password" autocomplete="current-password" required/>
          <div style="height:12px"></div>
          <button class="btn good" type="submit">Войти</button>
        </form>
        <p class="small">Если это первый запуск, учётка создаётся из ENV: <code>ADMIN_USER</code> / <code>ADMIN_PASS</code>.</p>
      </div>
    </div>
  </div>
</body>
</html>
